# Ubuntu/Linux .gitconfig — ported from mac/configs/.gitconfig
# NOTE: [user] is intentionally omitted. bootstrap.sh prompts for name/email
# (interactive) so this personal laptop never ships a hardcoded identity.

[init]
	defaultBranch = main

[core]
	pager = delta
	editor = nvim
	excludesFile = ~/.gitignore_global

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true
	side-by-side = true
	line-numbers = true

[merge]
	conflictStyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = default

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	followTags = true

[rebase]
	autoStash = true
	updateRefs = true

[commit]
	verbose = true

[tag]
	sort = version:refname

[help]
	autocorrect = prompt

[fetch]
	prune = true

[rerere]
	enabled = true

[branch]
	sort = -committerdate

[alias]
	sw = switch
	br = branch
	ci = commit
	st = status
	lg = log --oneline --graph --all --decorate

[credential "https://github.com"]
	helper =
	helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential
