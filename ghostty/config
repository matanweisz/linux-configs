# =============================================================================
# Ghostty Terminal - Tokyo Night (Ubuntu/Linux) — ported from mac/ghostty/config
# Docs: https://ghostty.org/docs/config/reference
# =============================================================================

# ---- Font ----
font-family = JetBrainsMono Nerd Font
font-size = 14
font-thicken = true

# ---- Theme ----
theme = TokyoNight Night

# ---- Window ----
window-padding-x = 12
window-padding-y = 8
background-opacity = 0.95
background-blur = 20
gtk-single-instance = true

# ---- Cursor ----
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# ---- Behavior ----
mouse-hide-while-typing = true
copy-on-select = clipboard

# Touchpad scroll damping. GNOME/Wayland has NO scroll-speed setting — the
# org.gnome.desktop.peripherals.touchpad schema has no such key, and libinput
# ships no scroll-factor quirk (only AttrTrackpointMultiplier, which is for
# trackpoints). Scroll rate can therefore only be tuned per-application.
# `precision` is the touchpad path (smooth/pixel scrolling); `discrete` is a
# mouse-wheel notch, left at its default of 3. Linux-only: the Mac trackpad
# does not need this, so mac/ghostty/config is intentionally not changed.
mouse-scroll-multiplier = precision:0.4,discrete:3

# ---- Keybindings (Linux: ctrl+shift instead of cmd) ----
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+left_bracket=previous_tab
keybind = ctrl+shift+right_bracket=next_tab
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down
