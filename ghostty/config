# =============================================================================
# Ghostty Terminal - Tokyo Night (Ubuntu/Linux) — ported from mac/ghostty/config
# Docs: https://ghostty.org/docs/config/reference
# =============================================================================

# ---- Font ----
font-family = JetBrainsMono Nerd Font
font-size = 14
font-thicken = true

# ---- Theme ----
theme = TokyoNight Night

# ---- Window ----
window-padding-x = 12
window-padding-y = 8
background-opacity = 0.95
background-blur-radius = 20
gtk-single-instance = true

# ---- Cursor ----
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# ---- Behavior ----
mouse-hide-while-typing = true
copy-on-select = clipboard

# ---- Keybindings (Linux: ctrl+shift instead of cmd) ----
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+left_bracket=previous_tab
keybind = ctrl+shift+right_bracket=next_tab
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down
