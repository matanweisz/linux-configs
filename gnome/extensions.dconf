# =============================================================================
# GNOME Shell extension settings — Ubuntu/Linux DevOps
#
# Loaded by install/gnome-extensions.sh with:
#     dconf load /org/gnome/shell/extensions/ < gnome/extensions.dconf
#
# WHY dconf AND NOT gsettings: a user-installed extension keeps its schema in
# ~/.local/share/gnome-shell/extensions/<uuid>/schemas/, which `gsettings` cannot
# see without GSETTINGS_SCHEMA_DIR. The gset() helper in install/gnome-setup.sh
# guards on `gsettings list-schemas` and would silently skip every key below.
# dconf writes the path directly and needs no schema.
#
# TO RE-EXPORT after tuning an extension in its prefs dialog:
#     dconf dump /org/gnome/shell/extensions/ > gnome/extensions.dconf
# then delete the stanzas for extensions not in install/gnome-extensions.sh's
# UUIDS list (dconf keeps settings for long-uninstalled extensions forever).
#
# Section names are dconf paths relative to /org/gnome/shell/extensions/, NOT
# extension UUIDs — they differ (rounded-window-corners@fxgn writes to
# `rounded-window-corners-reborn`).
# =============================================================================

# ---- Blur My Shell: panel + overview + dock blur (macOS vibrancy analogue) ----
[blur-my-shell]
hacks-level=1
pipelines={'pipeline_default': {'name': <'Default'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_000000000000'>, 'params': <{'radius': <30>, 'brightness': <0.69999999999999996>, 'unscaled_radius': <10>}>}>]>}, 'pipeline_default_rounded': {'name': <'Default rounded'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_000000000001'>, 'params': <{'radius': <30>, 'brightness': <0.75>, 'unscaled_radius': <20>}>}>, <{'type': <'corner'>, 'id': <'effect_000000000002'>, 'params': <{'radius': <24>}>}>]>}}
settings-version=2

[blur-my-shell/appfolder]
blur=false

[blur-my-shell/coverflow-alt-tab]
blur=false
pipeline='pipeline_default'

[blur-my-shell/dash-to-dock]
pipeline='pipeline_default_rounded'
static-blur=true
unblur-in-overview=false

[blur-my-shell/lockscreen]
pipeline='pipeline_default'

[blur-my-shell/overview]
pipeline='pipeline_default'
style-components=3

[blur-my-shell/panel]
brightness=0.75
pipeline='pipeline_default'
sigma=10
static-blur=false

[blur-my-shell/screenshot]
blur=false
pipeline='pipeline_default'

[blur-my-shell/window-list]
blur=false
brightness=0.69999999999999996
sigma=10

# ---- Dash to Dock ----
# ubuntu-dock@ubuntu.com is a fork of this extension and shares this exact schema
# path, so these keys apply either way. Ubuntu Dock destroys its own dock when
# dash-to-dock is loaded (see its extension.js _conditionallyEnableDock), so no
# manual disable is needed.
[dash-to-dock]
animation-time=0.10000000000000002
apply-custom-theme=false
autohide=true
autohide-in-fullscreen=true
background-color='rgb(17,61,104)'
background-opacity=0.79000000000000004
click-action='focus-minimize-or-previews'
custom-background-color=true
custom-theme-shrink=false
dash-max-icon-size=48
disable-overview-on-startup=true
dock-fixed=false
dock-position='BOTTOM'
extend-height=false
height-fraction=0.59999999999999998
hide-delay=0.25
hide-tooltip=false
intellihide=true
intellihide-mode='ALL_WINDOWS'
middle-click-action='launch'
multi-monitor=false
preferred-monitor=-2
pressure-threshold=50.0
preview-size-scale=0.0
running-indicator-style='DEFAULT'
shift-click-action='minimize'
shift-middle-click-action='launch'
show-apps-at-top=true
show-mounts=true
show-mounts-network=true
show-mounts-only-mounted=true
show-trash=false
transparency-mode='DYNAMIC'

# ---- Just Perfection: shell de-cluttering + faster animations ----
# animation=3 is the "fast" preset — the single biggest perceived-snappiness win.
# search=false / show-apps-button=false: Vicinae (Super+Space) replaces both.
[just-perfection]
accessibility-menu=false
animation=3
background-menu=true
calendar=true
controls-manager-spacing-size=0
dash=true
dash-app-running=true
dash-icon-size=0
double-super-to-appgrid=false
events-button=true
max-displayed-search-results=0
osd=true
panel=true
panel-in-overview=true
ripple-box=false
search=false
show-apps-button=false
startup-status=0
switcher-popup-delay=false
theme=false
top-panel-position=0
weather=false
window-demands-attention-focus=true
window-maximized-on-create=false
window-picker-icon=true
window-preview-caption=true
window-preview-close-button=true
workspace=true
workspace-background-corner-size=0
workspace-popup=true
workspace-switcher-should-show=false
workspace-wrap-around=true
workspaces-in-app-grid=true

# ---- Lock Keys: caps-lock OSD only when active ----
[lockkeys]
capslock-indicator='when-active'
notification-preferences='osd'
numlock-indicator='never'
style='none'

# ---- Media Controls: now-playing in the top panel ----
[mediacontrols]
elements-order=['ICON', 'LABEL', 'CONTROLS']
extension-index=uint32 2
extension-position='Left'
hide-media-notification=true
label-width=uint32 200
labels-order=['ARTIST', '(', 'ALBUM', ')', '-', 'TITLE']
show-control-icons-seek-backward=false
show-control-icons-seek-forward=false

# ---- Quick Settings Tweaks ----
[quick-settings-tweaks]
media-smooth-scroll-speed=20

# ---- Rounded Window Corners (Reborn) ----
# UUID is rounded-window-corners@fxgn but it writes to this path.
[rounded-window-corners-reborn]
settings-version=uint32 7

# ---- Tiling Shell: the Aerospace + JankyBorders analogue ----
# window-border-color rgb(117,191,244) is the focus ring that replaces the Mac's
# JankyBorders (mac/configs/borders/bordersrc). 10px inner+outer gaps.
# `last-version-name-installed` and `overridden-settings` are deliberately NOT set
# here — Tiling Shell owns them (it uses overridden-settings to restore the GNOME
# keybindings it took over when it is disabled; a stale value would restore wrong).
[tilingshell]
enable-autotiling=true
enable-blur-selected-tilepreview=false
enable-blur-snap-assistant=false
enable-screen-edges-windows-suggestions=false
enable-smart-window-border-radius=false
enable-snap-assistant-windows-suggestions=false
enable-span-multiple-tiles=false
enable-tiling-system-windows-suggestions=true
enable-window-border=true
inner-gaps=uint32 10
layouts-json='[{"id":"2233314","tiles":[{"x":0,"y":0,"width":0.5,"height":1,"groups":[1]},{"x":0.5,"y":0,"width":0.49999999999999994,"height":1,"groups":[1]}]},{"id":"35636836","tiles":[{"x":0,"y":0,"width":0.4505208333333333,"height":1,"groups":[1]},{"x":0.4505208333333333,"y":0,"width":0.5494791666666725,"height":0.5166508087535681,"groups":[2,1]},{"x":0.4505208333333333,"y":0.5166508087535681,"width":0.5494791666666725,"height":0.48334919124643194,"groups":[2,1]}]},{"id":"55307138","tiles":[{"x":0,"y":0,"width":0.65625,"height":1,"groups":[1]},{"x":0.65625,"y":0,"width":0.3437500000000044,"height":1,"groups":[1]}]},{"id":"3305462","tiles":[{"x":0,"y":0,"width":1,"height":1,"groups":[]}]}]'
move-window-down=['']
move-window-up=['']
outer-gaps=uint32 10
quarter-tiling-threshold=uint32 1
restore-window-original-size=true
selected-layouts=[['2233314'], ['2233314'], ['2233314'], ['2233314']]
snap-assistant-animation-time=uint32 100
snap-assistant-threshold=20
span-multiple-tiles-activation-key=['1']
span-window-all-tiles=['<Super>Up']
span-window-down=['']
span-window-left=['<Control><Super>Left']
span-window-right=['<Control><Super>Right']
span-window-up=['']
tile-preview-animation-time=uint32 100
top-edge-maximize=true
window-border-color='rgb(117,191,244)'
window-border-width=uint32 2
window-use-custom-border-color=true

# ---- TopHat: CPU / memory / network in the panel (mac `stats` cask parity) ----
[tophat]
cpu-display='numeric'
fs-display='numeric'
fs-hide-in-menu='/boot/efi'
mem-abs-units=true
mem-display='numeric'
meter-fg-color='rgb(46,194,126)'
mount-to-monitor='/'
network-usage-unit='bytes'
position-in-panel='right'
refresh-rate='medium'
show-cpu=true
show-disk=false
show-fs=false
show-icons=true
show-mem=true
show-menu-actions=true
show-net=true
